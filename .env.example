# ========== ResHub Environment Variables ==========

# Flask App Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-strong-random-secret-key-here
DEBUG=True

# Application Info
APPLICATION_NAME=ResHub

# Login & Sessions
REMEMBER_COOKIE_DURATION=2592000
REMEMBER_COOKIE_SECURE=False

# ========== Database Configuration ==========

# Local development using SQLite
DATABASE_URL=sqlite:///instance/app.db

# Production (PostgreSQL) - Uncomment when using Docker
# DATABASE_URL=postgresql://postgres:postgres@db:5432/reshub
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=reshub

# ========== Vector Store (Qdrant) ==========
VECTOR_DB_HOST=qdrant
VECTOR_DB_PORT=6333
VECTOR_DB_API_KEY=  # Leave blank unless you enabled Qdrant authentication

# ========== External API Keys ==========

# Replace with your API keys
OPENAI_API_KEY=your_openai_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_key_here
CORE_API_KEY=your_core_api_key_here

# ========== File Storage ==========

PDF_STORAGE_PATH=storage/pdfs

# ========== Embedding & Chatbot Settings ==========

EMBEDDING_MODEL=text-embedding-3-large
CHUNK_SIZE=300
CHUNK_OVERLAP=50

CHATBOT_MODEL=gpt-4o-2024-08-06
CHATBOT_TEMPERATURE=0.2
CHATBOT_MAX_TOKENS=500

# ========== Rate Limiting ==========

RATE_LIMIT_PER_MINUTE=30

# ========== Teammate1 Branch Variables ==========

# Journal Finder & Messaging System
JOURNAL_DATA_PATH=data/journals.json
MESSAGE_RETENTION_DAYS=365
NOTIFICATION_MAX_AGE=30

# ========== Teammate2 Branch Variables (S3/MinIO) ==========

# S3/MinIO Configuration for file storage
S3_ENDPOINT=http://minio:9000  # Use localhost:9000 for local development
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_NAME=reshub-files
S3_USE_SSL=false
S3_USE_MINIO=true  # Set to false if using AWS S3

# ========== N8N Configuration (when using Docker) ==========

# Uncomment when using Docker with N8N workflow automation
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=reshub_admin_password
# N8N_HOST=n8n
# N8N_PORT=5678
# N8N_PROTOCOL=http
# N8N_PYTHON_ENABLED=true
